;;; molten-test.el --- MVP regression tests -*- lexical-binding: t; -*-
(setq native-comp-enable-subr-trampolines nil)
(require 'ert)
(require 'cl-lib)
(require 'molten)
(defmacro molten-test-buffer (&rest body)
  (declare (indent 0))
  `(let ((molten-state-directory (make-temp-file "molten-state-" t))
         (molten-execution-updated-hook nil))
     (unwind-protect
         (with-temp-buffer
           (setq buffer-file-name "/tmp/molten-source.py")
           (insert "# unique prefix\nprint('hello')\n# unique suffix\n")
           ,@body)
       (delete-directory molten-state-directory t))))
(defun molten-test-execution ()
  (goto-char (point-min)) (forward-line 1)
  (molten-execution-create (make-molten-session :id "session" :kernel-id "kernel")
                           (line-beginning-position) (line-end-position)))
(defun molten-test-message (id kind content &optional channel)
  `(("header" . (("msg_type" . ,kind))) ("parent_header" . (("msg_id" . ,id)))
    ("channel" . ,(or channel "iopub")) ("content" . ,content)))
(ert-deftest molten-bookkeeping-and-replacement ()
  (molten-test-buffer
    (let* ((source (buffer-string)) (e1 (molten-test-execution))
           (e2 (molten-test-execution)))
      (should (= 2 (length molten-executions)))
      (should-not (equal (molten-execution-id e1) (molten-execution-id e2)))
      (should (equal (molten-execution-slot-id e1) (molten-execution-slot-id e2)))
      (molten-execution-add-output e1 (make-molten-output :kind 'stream :name "stdout" :text "first"))
      (molten-execution-add-output e2 (make-molten-output :kind 'stream :name "stderr" :text "second"))
      (molten-display-render)
      (should (= 1 (length molten-display-overlays)))
      (should (eq e2 (overlay-get (car molten-display-overlays) 'molten-execution)))
      (should (equal source (buffer-string)))
      (should (equal "first" (molten-execution-stdout e1)))
      (should (equal "second" (molten-execution-stderr e2))))))
(ert-deftest molten-anchor-fresh-moved-stale-ambiguous ()
  (molten-test-buffer
    (let* ((e (molten-test-execution)) (a (molten-execution-anchor e)))
      (should (eq 'fresh (nth 2 (molten-anchor-locate a))))
      (goto-char (point-min)) (insert "# moved\n")
      (should (eq 'fresh (nth 2 (molten-anchor-locate a))))
      (goto-char (molten-execution-start e)) (search-forward "hello")
      (replace-match "changed")
      (molten-execution-refresh e)
      (should (eq 'stale (molten-execution-freshness e)))
      (should (eq 'stale (nth 2 (molten-anchor-locate a))))
      (goto-char (point-max))
      (insert (molten-anchor-before a) "other" (molten-anchor-after a))
      (should-not (molten-anchor-locate a)))))
(ert-deftest molten-anchor-duplicate-exact-orphan ()
  (molten-test-buffer
    (let ((a (molten-execution-anchor (molten-test-execution))))
      (goto-char (point-max)) (insert (molten-anchor-source a))
      (should-not (molten-anchor-locate a)))))
(ert-deftest molten-anchor-no-context-no-line-number-guess ()
  (with-temp-buffer
    (insert "x = 1")
    (let ((a (molten-anchor-create (point-min) (point-max))))
      (erase-buffer) (insert "x = 2")
      (should-not (molten-anchor-locate a)))))
(ert-deftest molten-anchors-ignore-narrowing ()
  (molten-test-buffer
    (let ((a (molten-execution-anchor (molten-test-execution))))
      (narrow-to-region (point-min) 4)
      (should (molten-anchor-locate a)))))
(ert-deftest molten-store-roundtrip-blobs-and-no-secrets ()
  (molten-test-buffer
    (let* ((e (molten-test-execution)) (png (unibyte-string 137 80 78 71 0 255))
           (s (make-molten-session :token "SECRET-TOKEN" :url "http://localhost")))
      (setf (molten-execution-state e) 'done)
      (molten-execution-add-output e (make-molten-output :kind 'stream :name "stdout" :text "héllo\n"))
      (molten-execution-add-output e (make-molten-output
                                    :kind 'display_data
                                    :data `(("image/png" . ,png) ("text/plain" . "figure")
                                            ("image/svg+xml" . "<svg/>"))))
      (molten-store-save e)
      (let ((loaded (car (molten-store-load buffer-file-name))))
        (should (equal "héllo\n" (molten-execution-stdout loaded)))
        (should (equal png (cdr (assoc "image/png" (molten-output-data
                                                   (cadr (molten-execution-outputs loaded)))))))
        (should (equal (molten-anchor-hash (molten-execution-anchor e))
                       (molten-anchor-hash (molten-execution-anchor loaded)))))
      (with-temp-buffer
        (insert-file-contents (car (directory-files (expand-file-name "records" molten-state-directory) t "json$")))
        (should-not (search-forward (molten-session-token s) nil t))
        (goto-char (point-min)) (should-not (search-forward (base64-encode-string png t) nil t)))
      (should (= 4 (length (directory-files (expand-file-name "blobs" molten-state-directory) nil "^[0-9a-f]")))))))
(ert-deftest molten-store-corrupt-record-isolated ()
  (molten-test-buffer
    (molten-store-save (molten-test-execution))
    (write-region "invalid" nil (expand-file-name "records/bad.json" molten-state-directory) nil 'silent)
    (cl-letf (((symbol-function 'display-warning) #'ignore))
      (should (= 1 (length (molten-store-load buffer-file-name)))))))
(ert-deftest molten-store-rejects-unsafe-blob-reference ()
  (should-error (molten-store--read-blob '(("blob" . "../../secret")))))
(ert-deftest molten-dispatch-interleaved-completion-and-late-output ()
  (molten-test-buffer
    (let* ((s (make-molten-session)) (a (molten-test-execution)) (b (molten-test-execution))
           (id (molten-execution-id a)))
      (puthash id a (molten-session-executions s))
      (puthash (molten-execution-id b) b (molten-session-executions s))
      (molten-jupyter-dispatch s (molten-test-message "unrelated" "stream" '(("text" . "ignored"))))
      (molten-jupyter-dispatch s (molten-test-message id "status" '(("execution_state" . "busy"))))
      (should (eq 'running (molten-execution-state a)))
      (molten-jupyter-dispatch s (molten-test-message id "stream" '(("name" . "stdout") ("text" . "A"))))
      (molten-jupyter-dispatch s (molten-test-message (molten-execution-id b) "stream" '(("name" . "stderr") ("text" . "B"))))
      (molten-jupyter-dispatch s (molten-test-message id "execute_reply" '(("status" . "ok") ("execution_count" . 4)) "shell"))
      (should-not (eq 'done (molten-execution-state a)))
      (molten-jupyter-dispatch s (molten-test-message id "status" '(("execution_state" . "idle"))))
      (should (eq 'done (molten-execution-state a)))
      (should (= 4 (molten-execution-count a)))
      (molten-jupyter-dispatch s (molten-test-message id "stream" '(("name" . "stdout") ("text" . "late"))))
      (should (equal "Alate" (molten-execution-stdout a)))
      (should (equal "B" (molten-execution-stderr b))))))
(ert-deftest molten-dispatch-idle-first-error-and-mime ()
  (molten-test-buffer
    (let* ((s (make-molten-session)) (e (molten-test-execution)) (id (molten-execution-id e)))
      (puthash id e (molten-session-executions s))
      (dolist (kind '("execute_result" "display_data"))
        (molten-jupyter-dispatch s (molten-test-message
                                    id kind '(("execution_count" . 2)
                                              ("data" . (("text/plain" . "plot") ("image/png" . "UE5H")
                                                         ("image/svg+xml" . "<svg/>") ("text/html" . "ignored")))))))
      (should (= 2 (length (molten-execution-outputs e))))
      (should (equal "PNG" (cdr (assoc "image/png" (molten-output-data (car (molten-execution-outputs e)))))))
      (molten-jupyter-dispatch s (molten-test-message id "error" '(("traceback" . ("one" "two")))))
      (molten-jupyter-dispatch s (molten-test-message id "status" '(("execution_state" . "idle"))))
      (should-not (eq 'done (molten-execution-state e)))
      (molten-jupyter-dispatch s (molten-test-message id "execute_reply" '(("status" . "error")) "shell"))
      (should (eq 'error (molten-execution-state e)))
      (should (equal "one\ntwo" (molten-execution-traceback e))))))
(ert-deftest molten-disconnect-preserves-partial-output ()
  (molten-test-buffer
    (let ((s (make-molten-session)) (e (molten-test-execution)))
      (puthash (molten-execution-id e) e (molten-session-executions s))
      (setf (molten-execution-stdout e) "partial")
      (molten-jupyter-disconnected s)
      (should (eq 'disconnected (molten-execution-state e)))
      (should (equal "partial" (molten-execution-stdout e))))))
(ert-deftest molten-websocket-request-mock ()
  (molten-test-buffer
    (let ((s (make-molten-session :id "s" :state 'ready :socket 'mock))
          (e (molten-test-execution)) sent)
      (cl-letf (((symbol-function 'websocket-send-text)
                 (lambda (_ text) (setq sent (molten-json-read text)))))
        (molten-jupyter-execute s e))
      (should (equal "shell" (molten-get "channel" sent)))
      (should (equal (molten-execution-id e) (molten-get "msg_id" (molten-get "header" sent))))
      (should-not (molten-get "allow_stdin" (molten-get "content" sent)))
      (should (molten-get "store_history" (molten-get "content" sent)))
      (should (equal "print('hello')" (molten-get "code" (molten-get "content" sent)))))))
(ert-deftest molten-http-mock-auth-prefix-status-cleanup ()
  (let ((s (molten-jupyter-session "http://localhost:18888/base/" "token-value")) captured response)
    (cl-letf (((symbol-function 'url-retrieve-synchronously)
               (lambda (url &rest _)
                 (setq captured (list url url-request-method url-request-extra-headers url-request-data))
                 (setq response (generate-new-buffer " *http-mock*"))
                 (with-current-buffer response
                   (setq-local url-http-response-status 201)
                   (insert "HTTP/1.1 201 Created\r\nContent-Type: application/json\r\n\r\n{\"id\":\"k\"}"))
                 response)))
      (should (equal "k" (molten-get "id" (molten-jupyter-rest s "POST" "/api/kernels" '(("name" . "python3"))))))
      (should (equal "http://localhost:18888/base/api/kernels" (nth 0 captured)))
      (should (equal "token token-value" (cdr (assoc "Authorization" (nth 2 captured)))))
      (should-not (buffer-live-p response)))))
(ert-deftest molten-http-errors ()
  (let ((s (molten-jupyter-session "http://localhost" "")) response)
    (cl-letf (((symbol-function 'url-retrieve-synchronously) (lambda (&rest _) nil)))
      (should-error (molten-jupyter-list-kernels s)))
    (cl-letf (((symbol-function 'url-retrieve-synchronously)
               (lambda (&rest _)
                 (setq response (generate-new-buffer " *http-error*"))
                 (with-current-buffer response (setq-local url-http-response-status 403)) response)))
      (should-error (molten-jupyter-list-kernels s))
      (should-not (buffer-live-p response)))))
(ert-deftest molten-rejects-credentials-in-url ()
  (dolist (url '("http://host?token=secret" "http://user:secret@host" "http://host/#secret" "file:///tmp"))
    (should-error (molten-jupyter-session url ""))))
(ert-deftest molten-default-binary-frame ()
  (let* ((json "{\"channel\":\"iopub\"}")
         (payload (concat (unibyte-string 0 0 0 2 0 0 0 12 0 0 0 (+ 12 (length json))) json "BINARY")))
    (should (equal "iopub" (molten-get "channel" (molten-jupyter-decode payload t))))
    (should-error (molten-jupyter-decode (substring payload 0 10) t))))
(ert-deftest molten-display-image-preference-and-fallback ()
  (let ((o (make-molten-output :kind 'display_data :data '(("image/png" . "png") ("text/plain" . "fallback")))))
    (cl-letf (((symbol-function 'display-images-p) (lambda (&rest _) t))
              ((symbol-function 'image-type-available-p) (lambda (_) t))
              ((symbol-function 'create-image) (lambda (&rest _) '(image :type png))))
      (should (get-text-property 0 'display (molten-display--output o))))
    (cl-letf (((symbol-function 'display-images-p) (lambda (&rest _) nil)))
      (should (equal "fallback" (molten-display--output o))))))
(ert-deftest molten-display-large-traceback-and-clear ()
  (molten-test-buffer
    (let ((e (molten-test-execution)))
      (setf (molten-execution-traceback e) "boom")
      (molten-display-render)
      (should (string-match-p "molten-show-output" (overlay-get (car molten-display-overlays) 'after-string)))
      (setf (molten-execution-hidden e) t)
      (molten-display-render)
      (should-not molten-display-overlays)
      (should (= 1 (length molten-executions))))))
(ert-deftest molten-anchor-expanded-range-is-stale ()
  (molten-test-buffer
    (let* ((e (molten-test-execution)) (a (molten-execution-anchor e)))
      (goto-char (molten-execution-end e)) (insert " # changed")
      (should (eq 'stale (nth 2 (molten-anchor-locate a)))))))
(ert-deftest molten-websocket-open-mock ()
  (let ((original-require (symbol-function 'require))
        (s (molten-jupyter-session "http://localhost:18888/prefix" "secret")) url options)
    (setf (molten-session-kernel-id s) "kernel-id")
    (cl-letf (((symbol-function 'require)
               (lambda (feature &rest args)
                 (if (eq feature 'websocket) t (apply original-require feature args))))
              ((symbol-function 'websocket-open)
               (lambda (address &rest args) (setq url address options args) 'mock))
              ((symbol-function 'websocket-close) #'ignore))
      (molten-jupyter-open s)
      (should (string-prefix-p "ws://localhost:18888/prefix/api/kernels/kernel-id/channels?session_id=" url))
      (should-not (string-match-p "secret" url))
      (should-not (plist-get options :protocols))
      (should (equal "token secret" (cdr (assoc "Authorization" (plist-get options :custom-header-alist)))))
      (funcall (plist-get options :on-open) 'mock)
      (should (eq 'ready (molten-session-state s)))
      (funcall (plist-get options :on-close) 'old-socket)
      (should (eq 'ready (molten-session-state s)))
      (funcall (plist-get options :on-close) 'mock)
      (should (eq 'disconnected (molten-session-state s))))))
(provide 'molten-test)
;;; molten-test.el ends here
