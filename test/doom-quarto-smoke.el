;;; doom-quarto-smoke.el --- Opt-in installed Doom/Quarto test -*- lexical-binding: t; -*-
;; Generated from molten.org; edit that file, then run the tangle command.
;; Requires an installed Doom config with the Quarto/Molten adapter.
;; MOLTEN_TEST_URL/TOKEN configure Jupyter; PHASE is execute or restore.
(require 'ert)
(require 'cl-lib)
(defconst molten-quarto-root
  (or (getenv "MOLTEN_SOURCE_DIR")
      (file-name-directory (directory-file-name (file-name-directory load-file-name)))))
(defconst molten-quarto-file (expand-file-name "examples/molten-smoke.qmd" molten-quarto-root))
(setq user-emacs-directory (expand-file-name "~/.config/doom_emacs/")
      native-comp-enable-subr-trampolines nil native-comp-jit-compilation nil)
(load (expand-file-name "early-init.el" user-emacs-directory) nil t)
(dolist (dir (directory-files (expand-file-name (format ".local/straight/build-%s/" emacs-version) doom-emacs-dir) t "^[^.]"))
  (when (file-directory-p dir) (add-to-list 'load-path dir)))
(setq doom-disabled-packages nil doom-modules (make-hash-table :test #'equal))
(load (expand-file-name "init.el" doom-user-dir) nil t)
(load (expand-file-name "modules/config/use-package/init.el" doom-emacs-dir) nil t)
(require 'python)
(require 'evil)
(require 'doom-keybinds)
;; Exercise the installed integration with Doom's actual macros. Skip unrelated
;; GUI/preview configuration so this test can run in batch without side effects.
(with-temp-buffer
  (insert-file-contents (or (getenv "MOLTEN_DOOM_CONFIG")
                           (expand-file-name "config.el" doom-user-dir)))
  (goto-char (point-min)) (search-forward "(defvar my/molten-source-directory") (beginning-of-line)
  (let ((end (save-excursion (search-forward ";; Quarto chunk evaluation through Molten:1 ends here")
                             (line-beginning-position)))
        (byte-compile-current-file "molten-quarto-smoke"))
    (while (< (point) end) (eval (read (current-buffer)) t))))
(require 'code-cells)
(require 'quarto-mode)
(setq molten-state-directory (expand-file-name "state/" (getenv "MOLTEN_TEST_DIR")))
(defun molten-quarto-wait (predicate)
  "Process events for up to 45 seconds until PREDICATE succeeds."
  (let ((end (+ (float-time) 45)))
    (while (and (not (funcall predicate)) (< (float-time) end))
      (accept-process-output nil 0.05))
    (should (funcall predicate))))
(defun molten-quarto-open ()
  "Open the fixture and return (BASE VIEW) at the first Python chunk."
  (let ((base (find-file-noselect molten-quarto-file)))
    (set-buffer base)
    (goto-char (point-min)) (search-forward "print(f")
    (pm-switch-to-buffer)
    (evil-local-mode 1) (evil-normal-state)
    (should (derived-mode-p 'python-mode))
    (should (bound-and-true-p poly-quarto-mode))
    (should molten-mode)
    (list base (current-buffer))))
(defun molten-quarto-check-output (base view)
  "Verify shared records and visible output in BASE and VIEW."
  (let ((e (car (buffer-local-value 'molten-executions base))))
    (should (eq base (molten-execution-buffer e)))
    (should (eq 'done (molten-execution-state e)))
    (should (eq 'fresh (molten-execution-freshness e)))
    (should (string-match-p "Molten Quarto smoke: sum = 6" (molten-execution-stdout e)))
    (should-not (string-match-p "SECOND CHUNK" (molten-execution-stdout e)))
    (should (cl-some (lambda (o) (assoc "image/png" (molten-output-data o))) (molten-execution-outputs e)))
    (should (cl-some (lambda (o) (and (eq (molten-output-kind o) 'execute_result)
                                    (equal "6" (cdr (assoc "text/plain" (molten-output-data o))))))
                     (molten-execution-outputs e)))
    (dolist (buffer (list base view))
      (with-current-buffer buffer
        (should-not (buffer-modified-p))
        (should (= 1 (length molten-display-overlays)))
        (should (eq buffer (overlay-buffer (car molten-display-overlays))))
        (should (eq e (overlay-get (car molten-display-overlays) 'molten-execution)))))
    e))
(ert-deftest molten-quarto-execute ()
  (let ((original (with-temp-buffer (insert-file-contents-literally molten-quarto-file) (buffer-string))))
    (molten-connect (getenv "MOLTEN_TEST_URL") (or (getenv "MOLTEN_TEST_TOKEN") ""))
    (unwind-protect
        (progn
          (molten-start-kernel "python3")
          (molten-quarto-wait (lambda () (eq 'ready (molten-session-state molten-current-session))))
          (pcase-let* ((`(,base ,view) (molten-quarto-open))
                       (initial-count (length (buffer-local-value 'molten-executions base))))
            (with-current-buffer view
              (let ((command (key-binding (kbd "SPC m RET"))))
                (should (eq command 'polymode-eval-region-or-chunk))
                (call-interactively command))
              (let ((e (car (buffer-local-value 'molten-executions base))))
                (should (string-prefix-p "%matplotlib inline" (molten-anchor-source (molten-execution-anchor e))))
                (should-not (string-match-p "```\\|jupyter:\\|SECOND CHUNK" (molten-anchor-source (molten-execution-anchor e))))
                (molten-quarto-wait (lambda () (memq (molten-execution-state e) '(done error disconnected)))))
              (molten-quarto-check-output base view)
              ;; Re-evaluation must also keep records in the file's base buffer.
              (call-interactively (key-binding (kbd "SPC m c r")))
              (let ((e (car (buffer-local-value 'molten-executions base))))
                (molten-quarto-wait (lambda () (memq (molten-execution-state e) '(done error disconnected)))))
              (molten-quarto-check-output base view)
              (should (= (+ initial-count 2) (length (buffer-local-value 'molten-executions base))))
              (should (= (+ initial-count 2) (length (molten-store-load molten-quarto-file))))
              (let ((saved-view view))
                (call-interactively (key-binding (kbd "SPC m c o")))
                (should (string-match-p "Molten Quarto smoke: sum = 6" (buffer-string)))
                (set-buffer saved-view)))))
      (when (and molten-current-session (molten-session-kernel-id molten-current-session))
        (molten-kill-kernel)))
    (should (equal original (with-temp-buffer (insert-file-contents-literally molten-quarto-file) (buffer-string))))
    (should-not (featurep 'jupyter))
    (should-not (featurep 'zmq))))
(ert-deftest molten-quarto-restore ()
  (should-not molten-current-session)
  (pcase-let ((`(,base ,view) (molten-quarto-open)))
    (should (>= (length (buffer-local-value 'molten-executions base)) 2))
    (molten-quarto-check-output base view)))
(ert-run-tests-batch-and-exit (concat "molten-quarto-" (or (getenv "MOLTEN_TEST_PHASE") "execute")))
;;; doom-quarto-smoke.el ends here
