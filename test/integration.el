;;; integration.el --- Opt-in real Jupyter Server smoke test -*- lexical-binding: t; -*-
;; MOLTEN_TEST_URL, MOLTEN_TEST_TOKEN and MOLTEN_TEST_DIR configure this test.
(require 'ert)
(require 'molten)
(defun molten-integration-wait (predicate)
  "Wait up to 45 seconds for PREDICATE while processing network events."
  (let ((deadline (+ (float-time) 45)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (should (funcall predicate))))
(ert-deftest molten-real-server ()
  (setq molten-state-directory (expand-file-name "state/" (getenv "MOLTEN_TEST_DIR")))
  (molten-connect (or (getenv "MOLTEN_TEST_URL") "http://127.0.0.1:18991")
                  (or (getenv "MOLTEN_TEST_TOKEN") ""))
  (unwind-protect
      (progn
        (molten-start-kernel "python3")
        (molten-integration-wait (lambda () (eq (molten-session-state molten-current-session) 'ready)))
        (should (cl-find (molten-session-kernel-id molten-current-session)
                         (molten-jupyter-list-kernels molten-current-session)
                         :key (lambda (m) (molten-get "id" m)) :test #'equal))
        (find-file (expand-file-name "real.py" (getenv "MOLTEN_TEST_DIR")))
        (erase-buffer)
        (insert "# unique prefix\n%matplotlib inline\nimport matplotlib.pyplot as plt\nprint('hello from kernel')\nplt.plot([1, 2, 3], [1, 4, 9])\nplt.show()\n# unique suffix\n")
        (save-buffer)
        (goto-char (point-min)) (forward-line 1)
        (let* ((beg (point)) (end (save-excursion (goto-char (point-max)) (forward-line -1) (1- (point))))
               (e (molten-eval-region beg end)))
          (molten-integration-wait (lambda () (memq (molten-execution-state e) '(done error disconnected))))
          (should (eq 'done (molten-execution-state e)))
          (should (string-match-p "hello from kernel" (molten-execution-stdout e)))
          (should (cl-some (lambda (o) (assoc "image/png" (molten-output-data o)))
                           (molten-execution-outputs e)))
          (should (= 1 (length molten-display-overlays)))
          (should-not (buffer-modified-p))
          (should (molten-store-load buffer-file-name)))
        (molten-restart-kernel)
        (molten-integration-wait (lambda () (eq (molten-session-state molten-current-session) 'ready)))
        (with-temp-buffer
          (insert "import time; print('starting', flush=True); time.sleep(30)")
          (let ((e (molten-eval-region (point-min) (point-max))))
            (molten-integration-wait (lambda () (string-match-p "starting" (molten-execution-stdout e))))
            (molten-interrupt)
            (molten-integration-wait (lambda () (eq (molten-execution-state e) 'error)))
            (should (string-match-p "KeyboardInterrupt" (molten-execution-traceback e))))))
    (when (molten-session-kernel-id molten-current-session) (molten-kill-kernel))))
(ert-run-tests-batch-and-exit)
;;; integration.el ends here
