;;; load-minimal.el --- No external runtime required -*- lexical-binding: t; -*-
(setq native-comp-enable-subr-trampolines nil)
(require 'cl-lib)
(let ((original-require (symbol-function 'require))
      (exec-path nil))
  (cl-letf (((symbol-function 'require)
             (lambda (feature &rest args)
               (when (memq feature '(websocket zmq emacs-zmq jupyter emacs-jupyter python))
                 (error "Forbidden load: %s" feature))
               (apply original-require feature args)))
            ((symbol-function 'call-process) (lambda (&rest _) (error "External process")))
            ((symbol-function 'start-process) (lambda (&rest _) (error "External process")))
            ((symbol-function 'make-process) (lambda (&rest _) (error "External process")))
            ((symbol-function 'make-network-process) (lambda (&rest _) (error "Network access")))
            ((symbol-function 'module-load) (lambda (&rest _) (error "Native module")))
            ((symbol-function 'json-parse-string) (lambda (&rest _) (error "Native JSON")))
            ((symbol-function 'json-serialize) (lambda (&rest _) (error "Native JSON"))))
    (require 'molten)
    (unless (equal 1 (molten-get "x" (molten-json-read "{\"x\":1}")))
      (error "Pure-Elisp JSON failed"))
    (dolist (feature '(zmq jupyter emacs-jupyter websocket))
      (when (featurep feature) (error "Unexpected feature: %s" feature)))))
(princ "Minimal load passed: no Python, ZMQ, websocket, native module or network\n")
;;; load-minimal.el ends here
