;;; restart.el --- Each invocation is a fresh Emacs process -*- lexical-binding: t; -*-
;; Generated from molten.org; edit that file, then run the tangle command.
(require 'ert)
(require 'molten)
(setq molten-state-directory (expand-file-name "state/" (getenv "MOLTEN_TEST_DIR")))
(defvar molten-test-file (expand-file-name "source.py" (getenv "MOLTEN_TEST_DIR")))
(ert-deftest molten-process-seed ()
  (with-temp-file molten-test-file (insert "# unique prefix\nprint('hello')\n# unique suffix\n"))
  (find-file molten-test-file)
  (molten-mode 1)
  (goto-char (point-min)) (forward-line 1)
  (let ((e (molten-execution-create (make-molten-session :id "offline-session")
                                    (line-beginning-position) (line-end-position))))
    (setf (molten-execution-state e) 'done)
    (molten-execution-add-output e (make-molten-output :kind 'stream :name "stdout" :text "hello\n"))
    (molten-execution-add-output e (make-molten-output :kind 'display_data
                                  :data '(("image/svg+xml" . "<svg xmlns=\"http://www.w3.org/2000/svg\"/>"))))
    (molten-execution-notify e)
    (should-not (buffer-modified-p))))
(ert-deftest molten-process-fresh ()
  (find-file molten-test-file)
  (should-not molten-current-session)
  (should molten-mode)
  (should (= 1 (length molten-display-overlays)))
  (should (eq 'fresh (molten-execution-freshness (car molten-executions))))
  (should (equal "hello\n" (molten-execution-stdout (car molten-executions))))
  (should (= 2 (length (molten-execution-outputs (car molten-executions)))))
  (should-not (buffer-modified-p)))
(ert-deftest molten-process-stale ()
  ;; Edit before visiting, representing an external edit while Emacs was closed.
  (with-temp-file molten-test-file (insert "# unique prefix\nprint('changed')\n# unique suffix\n"))
  (find-file molten-test-file)
  (should-not molten-current-session)
  (should (= 1 (length molten-display-overlays)))
  (should (eq 'stale (molten-execution-freshness (car molten-executions))))
  (should (equal "hello\n" (molten-execution-stdout (car molten-executions))))
  (should-not (buffer-modified-p)))
(ert-deftest molten-process-orphan ()
  (with-temp-file molten-test-file
    (insert "# unique prefix\nprint('hello')\n# unique suffix\nprint('hello')\n"))
  (find-file molten-test-file)
  (should (= 1 (length molten-executions)))
  (should-not molten-display-overlays)
  (should (eq 'orphaned (molten-execution-freshness (car molten-executions)))))
(ert-run-tests-batch-and-exit (getenv "MOLTEN_TEST_PHASE"))
;;; restart.el ends here
